# Ignore Python bytecode
__pycache__/
*.py[cod]

# Ignore Python packaging files
*.egg-info/

# pytest / mypy / ruff caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# benchmarks
.benchmarks/

# build artifacts
dist/
build/

# mkdocs site
site/

# venv
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude Code session scratch (worktrees, local settings). The task guides
# under .claude/skills/ are tracked source (see AGENTS.md).
.claude/*
!.claude/skills/
